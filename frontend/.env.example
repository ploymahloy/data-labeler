# Production build settings (see infra/terraform outputs).
VITE_API_URL=https://api.labeler.example.com
VITE_AUTH_MODE=cognito
# Cognito Hosted UI domain without scheme, e.g. labeler-prod.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Defaults to <origin>/auth/callback
VITE_COGNITO_REDIRECT_URI=
